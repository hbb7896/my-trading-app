FROM debian:bookworm-slim AS flutter-build
ARG FLUTTER_VERSION=3.47.2
ARG FLUTTER_SHA256=447878859d01ca9bfdb99a85f245af07ed8a15fedcd9d189c4749e8e92d1f185
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git xz-utils unzip libglu1-mesa && rm -rf /var/lib/apt/lists/*
RUN curl --fail --location --retry 3 "https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz" -o /tmp/flutter.tar.xz \
    && echo "${FLUTTER_SHA256}  /tmp/flutter.tar.xz" | sha256sum --check --strict \
    && tar -xJf /tmp/flutter.tar.xz -C /opt && rm /tmp/flutter.tar.xz
ENV PATH="/opt/flutter/bin:${PATH}"
RUN git config --global --add safe.directory /opt/flutter
WORKDIR /build
COPY apps/trend_lab_flutter/pubspec.yaml apps/trend_lab_flutter/pubspec.lock ./
RUN flutter pub get
COPY apps/trend_lab_flutter/lib ./lib
COPY apps/trend_lab_flutter/web ./web
RUN flutter build web --release

FROM node:24-alpine
WORKDIR /app
COPY apps/trend-lab-api/package.json apps/trend-lab-api/server.mjs apps/trend-lab-api/analysis.js apps/trend-lab-api/import.mjs apps/trend-lab-api/stock-codes.json ./
COPY --from=flutter-build /build/build/web ./web
ENV HOST=0.0.0.0 PORT=10000 DATA_DIR=/data WEB_DIR=/app/web
EXPOSE 10000
CMD ["node", "server.mjs"]
